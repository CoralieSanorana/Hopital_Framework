<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://javax.ee/xml/ns/javaxee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://javax.ee/xml/ns/javaxee
             https://javax.ee/xml/ns/javaxee/web-app_6_0.xsd"
         version="6.0">

    <listener>
        <listener-class>
            main.com.util.FrameworkContextListener
        </listener-class>
    </listener>

    <context-param>
        <param-name>package_controllers</param-name>
        <param-value>app.controller</param-value>
    </context-param>

    <servlet>
        <servlet-name>FrontServlet</servlet-name>
            <servlet-class>main.com.servlet.FrontServlet</servlet-class>

        <init-param>
            <param-name>package_controllers</param-name>
            <param-value>app.controller</param-value>
        </init-param>

        <init-param>
            <param-name>prefixe</param-name>
            <param-value>/WEB-INF/views/</param-value>
        </init-param>

        <init-param>
            <param-name>suffixe</param-name>
            <param-value>.jsp</param-value>
        </init-param>

        <init-param>
            <param-name>authorisation</param-name>
            <param-value>role</param-value>
        </init-param>

        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

</web-app>